<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Book Management</title>
    <link rel="stylesheet" href="/css/adminBooks.css">
    

</head>
<body>
    <!-- Success Modal -->
    <div id="successModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeSuccessModal()">&times;</span>
            <div style="font-size: 40px; color: green; text-align: center;">✔</div>
            <p style="font-size: 20px; text-align: center;">Book has been deleted successfully!</p>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div id="deleteModal">
        <div class="delete-modal-content">
            <p>Are you sure you want to delete this book?</p>
            <button class="confirm-btn" id="confirmDelete">Yes, Delete</button>
            <button class="cancel-btn" id="cancelDelete">Cancel</button>
            <div id="spinner" class="spinner"></div>
        </div>
    </div>

    <h1>Admin Book Management</h1>

    
    <a href="/admin/add-book" class="btn-primary">Add New Book</a>

    <div class="grid">
        <% books.forEach(book => { %>
            <div class="book-card">
                <!-- Book Image -->
                <div class="book-image">
                    <% if (book.image) { %>
                        <img src="<%= book.image %>" alt="<%= book.title %>">
                    <% } else { %>
                        <p style="padding: 50px; color: #888;">No image available</p>
                    <% } %>
                </div>
    
                <!-- Book Details -->
                <div class="book-details">
                    <h2><%= book.title %></h2>
                    <p><strong>Author:</strong> <%= book.author %></p>
                    <p>
                        <%- book.description ? book.description.split(' ').slice(0, 10).join(' ') + '...' : 'No description available.' %>
                        <button class="read-more" 
                                data-title="<%= book.title %>" 
                                data-description="<%= book.description || 'No description available.' %>" 
                                data-image="<%= book.image || '/path/to/default-image.jpg' %>">
                           Read More
                        </button>
                    </p>
                </div>
    
                <!-- Actions -->
                <div class="actions">
                    <a href="/admin/edit-book/<%= book._id %>">Edit</a>
                    <form action="/admin/delete-book/<%= book._id %>" method="POST" class="delete-form" data-id="<%= book._id %>">
                        <button type="button" onclick="showDeleteModal(event)">Delete</button>
                    </form>
                    <a href="/read/<%= book._id %>" class="btn success">Read this book</a>
                </div>
            </div>
        <% }); %>
        <!-- Container for the full description -->
        <div id="book-description-container" class="book-description-modal" style="display:none;">
            <button onclick="closeDescription()">Close</button>
            <div id="full-description"></div>
        </div>
    </div>
    <a href="/holyland/admin" class="back-link">Back to Dashboard</a>

    <div id="descriptionModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeModal()">&times;</span>
            <img id="modalImage" src="" alt="Book Cover" style="width:150px; height:auto; margin-bottom: 15px; display: block; margin: auto 0;">
            <h2 id="modalTitle"></h2>
            <p id="modalDescription"></p>
        </div>
    </div>

    <script>
                document.querySelectorAll('.read-more').forEach(button => {
        button.addEventListener('click', function() {
            const description = this.getAttribute('data-description');
            console.log(description)
            
            // Set description with innerHTML to preserve HTML tags
            const descriptionContainer = document.getElementById('full-description');
            descriptionContainer.innerHTML = description; // This will render HTML tags

            // Show the modal with the full description
            document.getElementById('book-description-container').style.display = 'block';
        });
    });
            // Modal functionality
            function openModal(title, description, imageSrc) {
            document.getElementById("modalTitle").textContent = title;
            document.getElementById("modalDescription").innerHTML = description;
            document.getElementById("modalImage").src = imageSrc;

            document.getElementById("descriptionModal").style.display = "block";
        }

        function closeModal() {
            document.getElementById("descriptionModal").style.display = "none";
        }

        // Event listener for the Read More button
        document.addEventListener("DOMContentLoaded", function() {
            const readMoreButtons = document.querySelectorAll('.read-more');
            
            readMoreButtons.forEach((button) => {
                button.addEventListener("click", function() {
                    const title = button.getAttribute('data-title');
                    const description = button.getAttribute('data-description');
                    const imageSrc = button.getAttribute('data-image');
                    openModal(title, description, imageSrc);
                });
            });
        });



        let deleteForm;

        function showDeleteModal(event) {
            event.preventDefault();
            deleteForm = event.target.closest('.delete-form');
            document.getElementById('deleteModal').style.display = "block";
        }

        document.getElementById('confirmDelete').addEventListener('click', () => {
            // Show spinner while deleting
            document.getElementById('spinner').style.display = "block";
            
            // Simulate deletion 
            setTimeout(() => {
                // Hide spinner and show success modal
                document.getElementById('spinner').style.display = "none";
                document.getElementById('deleteModal').style.display = "none";
                document.getElementById('successModal').style.display = "block";
                
                // Submit the form after the delay (simulating successful deletion)
                if (deleteForm) deleteForm.submit();
            }, 2000); // Simulate a 2-second delay for deletion process
        });

        document.getElementById('cancelDelete').addEventListener('click', () => {
            document.getElementById('deleteModal').style.display = "none";
        });


    </script>
</body>
</html>
