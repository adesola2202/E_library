<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Want to Read</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/wantToRead.css">
</head>
<body>
    <header>
        <h1>My Want to Read List</h1>
        <nav>
            <ul>
                <li><a href="/homepage">Home</a></li>
                <li><a href="/currently-reading">Currently Reading</a></li>
                <li><a href="/want-to-read">Want to Read</a></li>
                <li><a href="/search">Search</a></li>
            </ul>
        </nav>
    </header>

    <div class="library-container">
        <ul class="book-list">
            <% books.forEach(book => { %>
                <li class="book-item">
                    <img src="<%= book.image %>" alt="<%= book.title %>">
                    <div class="book-info">
                        <h2><%= book.title %></h2>
                        <p>Author: <%= book.author %></p>
                        <p><%= book.description 
                            ? book.description.split(' ').slice(0, 10).join(' ') + '...' 
                            : 'No description available.' %>
                        </p>
                        <a href="/add-to-currently-reading/<%= book._id %>" class="btn">Read this book</a>
                        <form action="/remove-from-want-to-read" method="POST">
                            <input type="hidden" name="bookId" value="<%= book._id %>">
                            <button type="submit">Remove</button>
                        </form>
                    </div>
                </li>
            <% }) %>
        </ul>
    </div>
</body>
</html>
