<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add New Book</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
            margin: 0;
            padding: 0;
        }
    
        .container {
            max-width: 800px;
            margin: 50px auto;
            background: #fff;
            padding: 20px; /* Ensure consistent padding on all sides */
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
    
        h1 {
            text-align: center;
            color: #333;
            margin-bottom: 20px;
        }
    
        form {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
    
        label {
            font-size: 1rem;
            color: #444;
        }
    
        input[type="text"], textarea, input[type="file"] {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 1rem;
            box-sizing: border-box;  /* Ensure padding is included in the width calculation */
        }
    
        textarea {
            min-height: 150px;
        }
    
        input[type="file"] {
            padding: 10px 0;  /* Adjust padding to make file input consistent */
        }
    
        button {
            padding: 10px 15px;
            font-size: 1rem;
            color: #fff;
            background: #007bff;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: background 0.3s;
        }
    
        button:hover {
            background: #0056b3;
        }

        .button {
            display: inline-block;
            padding: 10px 20px;
            font-size: 1rem;
            color: #fff;
            background-color: #007bff;
            text-align: center;
            border-radius: 4px;
            text-decoration: none;  /* Remove underline from link */
            transition: background-color 0.3s ease, transform 0.2s ease;
        }

        /* Hover state for the button */
        .button:hover {
            background-color: #0056b3;
            transform: translateY(-2px);  /* Slight lift effect on hover */
        }

    
        .back-link {
            display: block;
            text-align: center;
            margin-top: 15px;
            text-decoration: none;
            color: #007bff;
        }
    
        .back-link:hover {
            color: #0056b3;
        }
    
        /* Style for the image preview */
        .image-preview {
            max-width: 200px;
            margin-top: 15px;
            display: none;  /* Hidden by default */
        }
    
        /* Style for error messages */
        .error-message {
            color: red;
            font-size: 0.9rem;
            margin-top: -10px;
        }
    
        /* Media Queries for Responsiveness */
    
        @media (max-width: 768px) {
            .container {
                padding: 15px;
                max-width: 100%; /* Allow container to take full width on smaller screens */
            }
    
            h1 {
                font-size: 1.5rem;
            }
    
            input[type="text"], textarea, input[type="file"], button {
                font-size: 0.9rem; /* Slightly reduce font size on smaller screens */
                padding: 8px; /* Reduce padding for better fitting */
            }
    
            .image-preview {
                max-width: 150px; /* Adjust image preview size */
            }
    
            button {
                padding: 8px 12px; /* Smaller button padding */
            }
    
            .error-message {
                font-size: 0.8rem; /* Adjust error message font size */
            }
        }
    
        @media (max-width: 480px) {
            .container {
                padding: 10px;
                margin: 20px; /* Reduce margin on very small screens */
            }
    
            h1 {
                font-size: 1.2rem;
            }
    
            input[type="text"], textarea, input[type="file"], button {
                font-size: 0.8rem; /* Further reduce font size on very small screens */
                padding: 6px; /* Even smaller padding for smaller screens */
            }
    
            .image-preview {
                max-width: 120px; /* Adjust image preview size for very small screens */
            }
    
            button {
                padding: 6px 10px; /* Smaller button padding */
            }
    
            .error-message {
                font-size: 0.7rem; /* Smaller error message font size */
            }
        }
    </style>
    
</head>
<body>
    <div class="container">
        <h1>Add New Book</h1>
        <form id="add-book-form" action="/admin/add-book" method="POST" enctype="multipart/form-data">
            <label for="title">Title:</label>
            <input type="text" id="title" name="title" required>
            <div id="title-error" class="error-message"></div>
        
            <label for="author">Author:</label>
            <input type="text" id="author" name="author" required>
            <div id="author-error" class="error-message"></div>
        
            <label for="description">Description:</label>
            <textarea id="description" name="description"></textarea>
        
            <label for="image">Book Image:</label>
            <input type="file" id="image" name="Imgupload" accept="image/*" required>
            <div id="image-error" class="error-message"></div>
            
            <!-- Preview the image -->
            <img id="image-preview" class="image-preview" src="" alt="Image Preview">

            <label for="pdf">Book PDF:</label>
            <input type="file" id="book_content" name="Pdfupload" accept="application/pdf" required>
            <div id="pdf-error" class="error-message"></div>
        
            <button type="submit" id="submitPost">Add Book</button>
            <a href="/admin/books" class="button">Back to Admin Books</a>
        </form>
    </div>

    
    <!-- Include CK Editor CDN -->
    <script src="https://cdn.ckeditor.com/ckeditor5/36.0.1/classic/ckeditor.js"></script>


    <script>
    // Initialize CKEditor
    ClassicEditor
    .create(document.querySelector('#description'))
    .then(editor => {
           window.blogEditor = editor;

    })


        // Function to preview the image before uploading
        document.querySelector('#image').addEventListener('change', function(event) {
            const file = event.target.files[0];  // Get the selected file
            const reader = new FileReader();

            reader.onload = function(e) {
                // Set the image source to the file reader result
                const preview = document.getElementById('image-preview');
                preview.src = e.target.result;
                preview.style.display = 'block';  // Show the image preview
            };

            if (file) {
                reader.readAsDataURL(file);  // Read the file as a data URL
            }
        });

        // Client-side validation
        document.getElementById('add-book-form').onsubmit = function(event) {
            let formValid = true;
            const title = document.getElementById('title').value;
            const author = document.getElementById('author').value;
            const letterPattern = /^[A-Za-z\s]+$/;  // Only letters and spaces

            // Clear previous errors
            document.getElementById('title-error').innerHTML = '';
            document.getElementById('author-error').innerHTML = '';
            document.getElementById('image-error').innerHTML = '';
            document.getElementById('pdf-error').innerHTML = '';

            if (!letterPattern.test(title)) {
                formValid = false;
                document.getElementById('title-error').innerHTML = 'Title can only contain letters and spaces.';
            }

            if (!letterPattern.test(author)) {
                formValid = false;
                document.getElementById('author-error').innerHTML = 'Author can only contain letters and spaces.';
            }

            if (!formValid) {
                event.preventDefault();  // Prevent form submission if validation fails
            }

            return formValid;  // Return form validity status
        };
    </script>
</body>
</html>
