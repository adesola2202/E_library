<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add New Book</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
            margin: 0;
            padding: 0;
        }

        .container {
            max-width: 800px;
            margin: 50px auto;
            background: #fff;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        h1 {
            text-align: center;
            color: #333;
            margin-bottom: 20px;
        }

        form {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        label {
            font-size: 1rem;
            color: #444;
        }

        input[type="text"], textarea, input[type="file"] {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 1rem;
        }

        textarea {
            min-height: 150px;
        }

        button {
            padding: 10px 15px;
            font-size: 1rem;
            color: #fff;
            background: #007bff;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: background 0.3s;
        }

        button:hover {
            background: #0056b3;
        }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 15px;
            text-decoration: none;
            color: #007bff;
        }

        .back-link:hover {
            color: #0056b3;
        }

        /* Style for the image preview */
        .image-preview {
            max-width: 200px;
            margin-top: 15px;
            display: none;  /* Hidden by default */
        }

        /* Style for error messages */
        .error-message {
            color: red;
            font-size: 0.9rem;
            margin-top: -10px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Add New Book</h1>
        <form id="add-book-form" action="/admin/add-book" method="POST" enctype="multipart/form-data">
            <label for="title">Title:</label>
            <input type="text" id="title" name="title" required>
            <div id="title-error" class="error-message"></div>
        
            <label for="author">Author:</label>
            <input type="text" id="author" name="author" required>
            <div id="author-error" class="error-message"></div>
        
            <label for="description">Description:</label>
            <textarea id="description" name="description"></textarea>
        
            <label for="image">Book Image:</label>
            <input type="file" id="image" name="Imgupload" accept="image/*" required>
            <div id="image-error" class="error-message"></div>
            
            <!-- Preview the image -->
            <img id="image-preview" class="image-preview" src="" alt="Image Preview">

            <label for="pdf">Book PDF:</label>
            <input type="file" id="pdf" name="Pdfupload" accept="application/pdf" required>
            <div id="pdf-error" class="error-message"></div>
        
            <button type="submit">Add Book</button>
        </form>
    </div>

    
    <!-- Include TinyMCE CDN -->
<script src="https://cdn.tiny.cloud/1/xsvfpksqk482n861zy14xasoj2rzq8dewyb09c0uytur8jo8/tinymce/6/tinymce.min.js"></script>


    <script>
    // Initialize TinyMCE editor
    tinymce.init({
        selector: '#description',
        plugins: 'removeformat',  // Add the removeformat plugin
        toolbar: 'removeformat',  // Show the removeformat button in the toolbar
        valid_elements: 'p,br',  // Only allow <p> and <br> tags (you can modify this if needed)
        content_style: "p, ul, ol, li { margin: 0; padding: 0; }",  // Basic styling to prevent unnecessary spacing
        setup: function(editor) {
            editor.on('change', function() {
                // Automatically remove unwanted HTML tags (e.g., <strong>, <em>)
                let content = editor.getContent();
                let plainTextContent = content.replace(/<\/?[^>]+(>|$)/g, "");  // Remove all HTML tags
                editor.setContent(plainTextContent);  // Set the cleaned-up content back to the editor
            });
        }
    });

        // Function to preview the image before uploading
        document.querySelector('#image').addEventListener('change', function(event) {
            const file = event.target.files[0];  // Get the selected file
            const reader = new FileReader();

            reader.onload = function(e) {
                // Set the image source to the file reader result
                const preview = document.getElementById('image-preview');
                preview.src = e.target.result;
                preview.style.display = 'block';  // Show the image preview
            };

            if (file) {
                reader.readAsDataURL(file);  // Read the file as a data URL
            }
        });

        // Client-side validation
        document.getElementById('add-book-form').onsubmit = function(event) {
            let formValid = true;
            const title = document.getElementById('title').value;
            const author = document.getElementById('author').value;
            const letterPattern = /^[A-Za-z\s]+$/;  // Only letters and spaces

            // Clear previous errors
            document.getElementById('title-error').innerHTML = '';
            document.getElementById('author-error').innerHTML = '';
            document.getElementById('image-error').innerHTML = '';
            document.getElementById('pdf-error').innerHTML = '';

            if (!letterPattern.test(title)) {
                formValid = false;
                document.getElementById('title-error').innerHTML = 'Title can only contain letters and spaces.';
            }

            if (!letterPattern.test(author)) {
                formValid = false;
                document.getElementById('author-error').innerHTML = 'Author can only contain letters and spaces.';
            }

            if (!formValid) {
                event.preventDefault();  // Prevent form submission if validation fails
            }

            return formValid;  // Return form validity status
        };
    </script>
</body>
</html>
