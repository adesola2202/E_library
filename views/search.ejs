<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Search Books</title>
    <link rel="stylesheet" href="/css/search.css">
</head>
<body>
    <header>
        <h1>Search Results</h1>
        <nav>
            <ul>
                <li><a href="/homepage">Home</a></li>
                <li><a href="/currently-reading">Currently Reading</a></li>
                <li><a href="/want-to-read">Want to Read</a></li>
                <li><a href="/search">Search</a></li>
            </ul>
        </nav>
    </header>

    <form action="/search" method="get">
        <input type="text" name="q" placeholder="Search for books..." value="<%= typeof q !== 'undefined' ? q : '' %>">
        <button type="submit">Search</button>
    </form>

    <section>
        <% if (message) { %>
            <p style="text-align: center; color: #e74c3c; font-size: 1.2rem;"><%= message %></p>
        <% } else { %>
            <ul>
                <% books.forEach(book => { %>
                    <li>
                        <img src="<%= book.image || '/placeholder.jpg' %>" alt="<%= book.title %>">
                        <strong>Title:</strong> <%= book.title %><br>
                        <strong>Author:</strong> <%= book.author %><br>
                        <strong>Description:</strong>
                        
                        <div class="book-description">
                            <span class="description-truncated"><%= book.description %></span>
                            <span class="description-full" style="display: none;"><%= book.description %></span>
                            <a href="#" class="read-more">Read More</a>
                            <a href="#" class="read-less" style="display: none;">Read Less</a>
                        </div>
                    </li>
                <% }) %>
            </ul>
        <% } %>
    </section>

    <script>
        // JavaScript to handle Read More/Read Less toggle
        document.addEventListener('DOMContentLoaded', function() {
            const readMoreBtns = document.querySelectorAll('.read-more');
            const readLessBtns = document.querySelectorAll('.read-less');
            const descriptionsTruncated = document.querySelectorAll('.description-truncated');
            const descriptionsFull = document.querySelectorAll('.description-full');

            readMoreBtns.forEach((btn, index) => {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    descriptionsTruncated[index].style.display = 'none';
                    descriptionsFull[index].style.display = 'inline-block';
                    btn.style.display = 'none';
                    readLessBtns[index].style.display = 'inline-block';
                });
            });

            readLessBtns.forEach((btn, index) => {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    descriptionsTruncated[index].style.display = 'inline-block';
                    descriptionsFull[index].style.display = 'none';
                    btn.style.display = 'none';
                    readMoreBtns[index].style.display = 'inline-block';
                });
            });
        });
    </script>
</body>
</html>
