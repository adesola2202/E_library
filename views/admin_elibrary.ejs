<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin E-Library</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Roboto', sans-serif;
            margin: 0;
            padding: 20px;
            background-color: #f4f4f4;
        }
        h1 {
            text-align: center;
            margin-bottom: 20px;
            color: #333;
        }
        .container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
            padding: 20px;
        }
        .card {
            background: white;
            border-radius: 10px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            transition: transform 0.3s, box-shadow 0.3s;
            width: 300px;
            position: relative;
        }
        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
        }
        .card img {
            width: 100%;
            height: auto;
            border-bottom: 5px solid #007bff;
        }
        .card-content {
            padding: 15px;
        }
        .card-title {
            font-size: 1.5em;
            font-weight: 500;
            color: #007bff;
            margin: 0 0 10px;
        }
        .card-authors {
            color: #666;
            font-size: 0.9em;
            margin-bottom: 10px;
        }
        .card-description {
            margin: 10px 0;
            font-size: 0.95em;
            color: #333;
        }
        .card-actions {
            display: flex;
            justify-content: space-between;
            margin-top: 15px;
        }
        .btn {
            background: #007bff;
            color: white;
            padding: 10px 15px;
            border: none;
            border-radius: 5px;
            text-decoration: none;
            cursor: pointer;
            transition: background 0.3s;
            font-weight: 500;
        }
        .btn:hover {
            background: #0056b3;
        }
        .add-btn {
            background: #28a745;
            margin-bottom: 20px;
            text-align: center;
            display: inline-block;
            text-decoration: none;
        }
        .add-btn:hover {
            background: #218838;
        }
        .no-books {
            text-align: center;
            width: 100%;
            font-size: 1.2em;
            color: #777;
        }
    </style>
</head>
<body>
    <h1>Admin E-Library</h1>

    <!-- Display success message if available -->
    <% if (message) { %>
        <div class="message"><%= message %></div>
    <% } %>
    
    <!-- Add Book Button -->
    <a href="/admin/add" class="btn add-btn">Add Book</a>
    <a href="/admin/users/add" class="btn add-btn">Add User</a>
    <button id="toggleUserList" class="btn">Show Users</button>

    <div class="container">
        <% if (books.length === 0) { %>
            <div class="no-books">No books found.</div>
        <% } else { %>
            <% books.forEach(book => { %>
                <% if (book.volumeInfo) { %>
                    <div class="card">
                        <img src="<%= book.volumeInfo.imageLinks ? book.volumeInfo.imageLinks.thumbnail : 'https://via.placeholder.com/128x198' %>" alt="<%= book.volumeInfo.title %>">
                        <div class="card-content">
                            <div class="card-title"><%= book.volumeInfo.title %></div>
                            <div class="card-authors"><%= book.volumeInfo.authors ? book.volumeInfo.authors.join(', ') : 'Unknown' %></div>
                            <div class="card-description">
                                <%= book.volumeInfo.description ? book.volumeInfo.description : 'No description available' %>
                            </div>
                            <div class="card-actions">
                                <a class="btn" href="<%= book.volumeInfo.previewLink || '#' %>" target="_blank">View Preview</a>
                                <div>
                                    <a class="btn" href="/admin/edit/<%= book._id %>">Edit</a>
                                    <form action="/admin/delete/<%= book._id %>" method="POST" style="display:inline;">
                                        <button type="submit" class="btn">Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } %>
            <% }); %>
        <% } %>
    </div>

    <!-- User Management Section -->
    <div id="userList">
        <% if (users.length === 0) { %>
            <div class="no-users">No users found.</div>
        <% } else { %>
            <% users.forEach(user => { %>
                <div class="user-card">
                    <div class="user-info">
                        <div><strong>Username:</strong> <%= user.username %></div>
                        <div><strong>Email:</strong> <%= user.email %></div>
                    </div>
                    <div class="user-actions">
                        <form action="/admin/users/delete/<%= user._id %>" method="POST">
                            <button type="submit" class="btn delete-btn">Delete User</button>
                        </form>
                    </div>
                </div>
            <% }); %>
        <% } %>
    </div>

    <script>
        // Auto-hide the success message after 3 seconds
        setTimeout(() => {
            const message = document.querySelector('.message');
            if (message) {
                message.style.display = 'none';
            }
        }, 3000); // 3000 milliseconds = 3 seconds

        // Toggle user list visibility
        document.getElementById('toggleUserList').addEventListener('click', function() {
            const userList = document.getElementById('userList');
            if (userList.style.display === 'none' || userList.style.display === '') {
                userList.style.display = 'block';
                this.textContent = 'Hide Users';
            } else {
                userList.style.display = 'none';
                this.textContent = 'Show Users';
            }
        });
    </script>
</body>
</html>