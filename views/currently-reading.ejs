<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Currently Reading</title>
    <link rel="stylesheet" href="/css/currently.css">
</head>
<body>
    <header>
        <h1>Currently Reading</h1>
        <nav>
            <ul>
                <li><a href="/homepage">Home</a></li>
                <li><a href="/currently-reading">Currently Reading</a></li>
                <li><a href="/want-to-read">Want to Read</a></li>
                <li><a href="/search">Search</a></li>
            </ul>
        </nav>
    </header>

    <section>
        <h2>Your Currently Reading Books</h2>
        <ul class="book-list">
            <% currentlyReadingBooks.forEach(book => { %>
                <li class="book-item">
                    <img src="<%= book.volumeInfo.imageLinks ? book.volumeInfo.imageLinks.thumbnail : 'https://via.placeholder.com/128x198' %>" alt="Book Cover">
                    <div>
                        <h3><%= book.volumeInfo.title %></h3>
                        <p>Authors: <%= book.volumeInfo.authors ? book.volumeInfo.authors.join(', ') : 'Unknown' %></p>
                        <p>
                            <a href="<%= book.previewLink %>" target="_blank" class="preview-link">Preview</a>
                        </p>
                    </div>
                </li>
            <% }); %>
        </ul>
    </section>
</body>
</html>